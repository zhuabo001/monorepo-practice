{
  "name": "monorepo-practice",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:backend": "vitest --project=back-end",
    "test:frontend": "vitest --project=front-end",
    "test:components": "vitest --project=components",
    "test:core": "vitest --project=core",
    "lint:prettier": "prettier --write \"**/*.{js,ts,mjs,cjs,json,tsx,css,less,scss,vue,html,md}\"",
    "lint": "eslint --ext .js,.ts,.mjs,.cjs,.vue --fix \"**/*.{js,ts,mjs,cjs,json,tsx,css,less,scss,vue,html,md}\"",
    "commit": "git-cz",
    "precommit": "lint-staged",
    "prepare": "husky",
    "build": "./scripts/build.js",
    "dev": "./scripts/dev.js",
    "publish:core": "pnpm --filter monorepo-practice/core publish --no-git-checks",
    "rush:update": "rush update",
    "rush:build": "rush build",
    "rush:test": "rush test",
    "rush:publish": "rush publish --apply --publish --include-all --target-branch develop",
    "rush:version": "rush version --bump --target-branch develop",
    "rush:change": "rush change",
    "rush:setup": "./scripts/setup-rush.sh"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.6.1",
  "engines": {
    "node": ">=22.14.0",
    "pnpm": ">=10.6.1",
    "npm": ">=9.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.0.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/js": "^9.36.0",
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-node-resolve": "^16.0.2",
    "@rollup/plugin-replace": "^6.0.2",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.4",
    "@types/node": "^24.5.2",
    "@vitest/coverage-v8": "^2.1.8",
    "@vitest/ui": "^2.1.8",
    "commitizen": "^4.3.1",
    "cz-git": "^1.12.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-vue": "^10.5.0",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^16.2.1",
    "prettier": "^3.6.2",
    "rollup": "^4.52.4",
    "rollup-plugin-postcss": "^4.0.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vitest": "^2.1.8"
  }
}

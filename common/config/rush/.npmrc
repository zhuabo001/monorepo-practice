/**
 * 当 Rush 执行 "pnpm install" 时，此文件提供额外的配置。
 * 此文件是可选的。
 *
 * 文档: https://pnpm.io/npmrc
 */
# 默认情况下，如果工作区包存在循环依赖，pnpm 会失败。
# 如果你的项目有循环依赖，可以取消下面的注释：
# ignore-cycles = true

# 配置公共注册表
registry=https://registry.npmjs.org/

# 使用更严格的依赖解析
strict-peer-dependencies=true

# 提升依赖到根节点（类似于 npm 的行为）
shamefully-hoist=false

# 保存精确的版本号
save-exact=true

# 使用内容可寻址存储
enable-pre-post-scripts=true